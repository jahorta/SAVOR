{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soasim.local/schemas/parity_report_v1.json",
  "title": "SoaSim SA3D parity report",
  "type": "object",
  "required": [
    "schema",
    "fixture",
    "reference",
    "metrics",
    "diagnostics",
    "comparison"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "parity_report_v1"
    },
    "fixture": {
      "type": "object",
      "required": [
        "id",
        "mld_path",
        "model_block_offset",
        "motion_block_offset"
      ],
      "properties": {
        "id": { "type": "string" },
        "mld_path": { "type": "string" },
        "model_block_offset": { "type": ["integer", "null"], "minimum": 0 },
        "motion_block_offset": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["source", "tag", "commit"],
      "properties": {
        "source": { "type": "string" },
        "tag": { "type": "string" },
        "commit": { "type": "string" },
        "runner_branch": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["structural", "semantic"],
      "properties": {
        "structural": { "type": "object" },
        "semantic": { "type": "object" }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "stage"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "stage": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] }
        },
        "additionalProperties": true
      }
    },
    "comparison": {
      "type": "object",
      "required": ["pass", "mismatch_count"],
      "properties": {
        "pass": { "type": "boolean" },
        "mismatch_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "slice_io_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slice", "pairs"],
        "properties": {
          "slice": { "type": "integer", "minimum": 0 },
          "pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["function_id", "input_fields", "output"],
              "properties": {
                "function_id": { "type": "string" },
                "input_fields": { "type": "object" },
                "output": { "type": "object" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
