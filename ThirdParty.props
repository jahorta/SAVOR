<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <DOLPHIN_ROOT>$(SolutionDir)third-party\dolphin-2506a</DOLPHIN_ROOT>
    <GTEST_ROOT>$(SolutionDir)third-party\googletest-1.17.0</GTEST_ROOT>
    <SQLITE_ROOT>$(SolutionDir)third-party\sqlite</SQLITE_ROOT>
  </PropertyGroup>
  <PropertyGroup>
    <IntDir>$(SolutionDir)obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(DOLPHIN_ROOT)\include\Source;$(DOLPHIN_ROOT)\include\Source\Core;$(DOLPHIN_ROOT)\include\Externals\fmt\fmt\include;$(DOLPHIN_ROOT)\include\Externals\lz4\lz4\lib;$(DOLPHIN_ROOT)\include\Externals\mbedtls\include;$(DOLPHIN_ROOT)\include\Externals\zlib-ng;$(SQLITE_ROOT)\include;$(GTEST_ROOT)\googletest\include;$(GTEST_ROOT)\googlemock-include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ExternalIncludeDirectories>$(DOLPHIN_ROOT)\include\Source;$(DOLPHIN_ROOT)\include\Source\Core;$(DOLPHIN_ROOT)\include\Externals\fmt\fmt\include;$(DOLPHIN_ROOT)\include\Externals\lz4\lz4\lib;$(DOLPHIN_ROOT)\include\Externals\mbedtls\include;$(DOLPHIN_ROOT)\include\Externals\zlib-ng;%(ExternalIncludeDirectories)</ExternalIncludeDirectories>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/Zc:preprocessor /external:I&quot;$(DOLPHIN_ROOT)\include\Source&quot; /external:I&quot;$(DOLPHIN_ROOT)\include\Source\Core&quot; /external:I&quot;$(DOLPHIN_ROOT)\include\Externals\fmt\fmt\include&quot; /external:I&quot;$(DOLPHIN_ROOT)\include\Externals\lz4\lz4\lib&quot; /external:I&quot;$(DOLPHIN_ROOT)\include\Externals\mbedtls\include&quot; /external:I&quot;$(DOLPHIN_ROOT)\include\Externals\zlib-ng&quot; /external:W0 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(DOLPHIN_ROOT)\lib\x64\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <Lib>
      <AdditionalLibraryDirectories>$(DOLPHIN_ROOT)\lib\x64\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Lib>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="DOLPHIN_ROOT">
      <Value>$(DOLPHIN_ROOT)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>
    <BuildMacro Include="GTEST_ROOT">
      <Value>$(GTEST_ROOT)</Value>
    </BuildMacro>
    <BuildMacro Include="SQLITE_ROOT">
      <Value>$(SQLITE_ROOT)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>
