# Graphify corpus policy for SAVOR:
# local-only, code-only, and no generated/build/reference trees.
#
# Prefer positive ignores over deny-all plus negated allowlists. This keeps
# renamed source trees visible while excluding known non-source material.

# VCS, IDE state, Codex scratch data, and previous local backups.
.git/
.vs/
.codex/
.non_qt2_backup/
_old files if needed/
.gitattributes
.gitignore
.graphifyignore

# Graphify output and build/generated output.
graphify-out/
bin/
obj/
x64/
**/bin/
**/obj/
**/x64/
**/.db_val/
**/.db_schema_cur/
**/.savor-e2e*/

# Stale generated folders left from pre-SAVOR project names.
SavorQt/SoaSimQt2/

# Vendored Dolphin emulator source overwhelms the SAVOR architecture graph.
SavorCore/_Dolphin_src/

# External/reference/prose-heavy trees are not part of the repo code graph.
third-party/
planning/
phase0/

# Keep the corpus code-only and AST/local-friendly.
*.db
*.db-shm
*.db-wal
*.ifc
*.json
*.log
*.md
*.module.json
*.obj
*.props
*.qrc
